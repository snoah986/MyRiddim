# Freebuff / myriddim local runtime configuration
# Copy this file to .env for local reference. The Flask process reads these
# variables from the process environment; it does not load .env automatically.

# Keep localhost unless the mobile remote is intentionally enabled on a
# trusted LAN/VPN. Binding to 0.0.0.0 exposes authenticated endpoints.
YTM_BIND_HOST=127.0.0.1

# Flask sidecar port; the Vite proxy and Tauri launcher currently default here.
YTM_BACKEND_PORT=5178

# Optional comma-separated extra CORS origins. Example for a trusted phone:
# YTM_CORS_ORIGINS=http://192.168.1.45:5178
YTM_CORS_ORIGINS=

# Optional override for credentials, SQLite, settings, cache metadata, and
# downloaded audio. Leave empty to use the platform user config directory.
# Windows: %APPDATA%\\ytm-player
# macOS/Linux: ~/.config/ytm-player
YTM_DATA_DIR=

# Set by the Tauri launcher for unbuffered sidecar logs.
PYTHONUNBUFFERED=1

# Not currently consumed by the runtime; reserved for the future cloud Party
# relay integration. Do not assume setting this enables cloud party routing.
# PARTY_RELAY_URL=
